{
	"name": "auto-agents-cli",
	"version": "0.0.0",
	"license": "GPL 3",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "babel --out-dir=dist source",
		"dev": "babel --out-dir=dist --watch source",
		"test": "prettier --check . && xo && ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"ansi-escapes": "^7.3.0",
		"cfonts": "^3.3.1",
		"cli-highlight": "^2.1.11",
		"cli-html": "^5.3.0",
		"cli-spinners": "^3.4.0",
		"ink": "6.2.0",
		"ink-syntax-highlight": "^2.0.2",
		"ink-text-input": "^6.0.0",
		"meow": "^11.0.0",
		"node-banner": "^1.4.0",
		"node-disk-info": "^1.3.0",
		"patch-console": "^2.0.0",
		"react": "^19.2.4",
		"shellwords": "^1.1.1",
		"terminal-kit": "^3.1.2",
		"wildcard": "^2.0.1"
	},
	"devDependencies": {
		"@babel/cli": "^7.28.6",
		"@babel/preset-react": "^7.28.5",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.3.1",
		"chalk": "^5.6.2",
		"eslint-config-xo-react": "^0.29.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.8",
		"xo": "^0.53.1"
	},
	"ava": {
		"environmentVariables": {
			"NODE_NO_WARNINGS": "1"
		},
		"nodeArguments": [
			"--loader=import-jsx"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config",
	"babel": {
		"presets": [
			"@babel/preset-react"
		]
	}
}