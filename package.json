		"cli-html": "^5.3.0",
		"cli-spinners": "^3.4.0",
		"console-table-printer": "^2.15.0",
		"fast-xml-parser": "^5.5.9",
		"fullscreen-ink": "^0.1.0",
		"htmlparser2": "^10.1.0",
		"ink": "6.2.0",
		"ink-picture": "^1.3.4",
		"ink-select-input": "^6.2.0",
		"ink-syntax-highlight": "^2.0.2",
		"ink-text-input": "^6.0.0",
		"meow": "^11.0.0",
		"node-banner": "^1.4.0",
		"node-disk-info": "^1.3.0",
		"ollama": "^0.6.3",
		"openai": "^6.22.0",
		"patch-console": "^2.0.0",
		"react": "^19.2.4",
		"remark": "^15.0.1",
		"sharp": "^0.34.5",
		"shellwords": "^1.1.1",
		"skills-ref": "^0.1.5",
		"strip-markdown": "^6.0.0",
		"terminal-kit": "^3.1.2",
		"unicode-emoji-utils": "^1.3.1",
		"wildcard": "^2.0.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@babel/cli": "^7.28.6",
		"@babel/preset-react": "^7.28.5",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.3.1",
		"chalk": "^5.6.2",
		"eslint-config-xo-react": "^0.29.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.8",
		"xo": "^0.53.1"
	},
	"ava": {
		"environmentVariables": {
			"NODE_NO_WARNINGS": "1"
		},
		"nodeArguments": [
			"--loader=import-jsx"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config",
	"babel": {
		"presets": [
			"@babel/preset-react"
		]
	},
	"description": "<table> <tr> <td> <h1>Auto Agents</h1>",
	"main": "index.js",
	"directories": {
		"doc": "doc"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/auto-agents/cli.git"
	},
	"keywords": [],
	"author": "",
	"bugs": {
		"url": "https://github.com/auto-agents/cli/issues"
