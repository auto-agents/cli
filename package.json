{
	"name": "auto-agents-cli",
	"version": "0.0.0",
	"license": "GPL 3",
	"bin": {
		"auto-agents-cli": "dist/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "babel --out-dir=dist src",
		"dev": "babel --out-dir=dist --watch src",
		"test": "prettier --check . && xo && ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@lmstudio/sdk": "^1.5.0",
